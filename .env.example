# Copy this file to .env and fill it in. Never put real values in this file:
# it is committed to git, .env is not.

# Discord Developer Portal → your application → Bot → Reset Token
TOKEN=your_discord_bot_token

# Discord Developer Portal → your application → General Information → Application ID
CLIENT_ID=your_application_id

# Optional: server ID for instant command updates while developing.
# Leave empty to deploy commands globally.
GUILD_ID=1474524750268072049

# Optional: where the SQLite database lives (default: storage/spacebet.db)
DATABASE_PATH=storage/spacebet.db

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=info
